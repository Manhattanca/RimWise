<Window x:Class="RimWise.Desktop.Views.OrderPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="排序预览" Width="760" Height="520" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner">
    <Border Padding="20" Background="{DynamicResource PageBrush}"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock x:Name="Summary" FontWeight="SemiBold" TextWrapping="Wrap" />
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Notice" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource MutedBrush}" />
            </ScrollViewer>
        </StackPanel>
        <DataGrid Style="{StaticResource ModListGrid}" x:Name="PreviewGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}"
                  RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource AlternateBrush}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding IndexLabel}" Width="54" />
                <DataGridTextColumn Header="模组标识" Binding="{Binding Identifier}" Width="*" />
                <DataGridTextColumn Header="变化" Binding="{Binding Change}" Width="130" />
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ConfirmButton" IsDefault="True" Content="载入清单" Click="Confirm_Click" />
            <Button x:Name="CancelButton" IsCancel="True" Content="取消" />
        </StackPanel>
    </Grid></Border>
</Window>
