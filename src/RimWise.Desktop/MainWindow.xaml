<Window x:Class="RimWise.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:RimWise.Desktop.Presentation"
        Style="{StaticResource {x:Type Window}}"
        Title="RimWise" Width="1360" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewDragOver="Window_FileDragOver" PreviewDrop="Window_FileDrop">
    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}" />
        <KeyBinding Key="Y" Modifiers="Control" Command="{Binding RedoCommand}" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="{Binding RedoCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
                <Border x:Name="SplitterHitArea" Background="{TemplateBinding Background}" CornerRadius="4">
                    <StackPanel Width="8" VerticalAlignment="Center" IsHitTestVisible="False">
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}" Margin="0,0,0,4" />
                        <Border Width="3" Height="24" CornerRadius="1.5" Background="{DynamicResource MutedBrush}" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SplitterHitArea" Property="Background" Value="{DynamicResource HeaderBrush}" /></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SplitterHitArea" Property="Background" Value="{DynamicResource HeaderBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <EventSetter Event="DragCompleted" Handler="PaneSplitter_DragCompleted" />
            <EventSetter Event="KeyUp" Handler="PaneSplitter_KeyUp" />
        </Style>
        <Style x:Key="ModGrid" TargetType="DataGrid" BasedOn="{StaticResource ModListGrid}">
            <Setter Property="CellStyle" Value="{StaticResource MarkedCell}" />
            <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" /><Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" /><Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="SelectionChanged" Handler="ModSelection_Changed" />
            <EventSetter Event="PreviewKeyDown" Handler="ModGrid_KeyDown" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ModGrid_MouseDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ModGrid_MouseUp" />
            <EventSetter Event="PreviewMouseMove" Handler="ModGrid_MouseMove" />
            <EventSetter Event="DragOver" Handler="ModGrid_DragOver" />
            <EventSetter Event="Drop" Handler="ModGrid_Drop" />
            <EventSetter Event="DragLeave" Handler="ModGrid_DragLeave" />
            <Setter Property="GridLinesVisibility" Value="None" /><Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateBrush}" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="AlternationCount" Value="2" /><Setter Property="RowStyle" Value="{StaticResource MarkedRow}" />
        </Style>
        <Style x:Key="ModName" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
        </Style>
        <Style x:Key="IssueMessage" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="ToolTip" Value="{Binding Location}" />
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource PageBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Menu x:Name="MainMenu" Padding="6,0" Height="32" MinHeight="0">
            <Menu.Template>
                <ControlTemplate TargetType="Menu">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Menu.Template>
            <Menu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                    <Style.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Padding" Value="12,3" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="MenuItem">
                                        <Grid>
                                            <Border x:Name="TopMenuChrome" Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                                            </Border>
                                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" Padding="4" CornerRadius="4">
                                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="600">
                                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                                                    </ScrollViewer>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="TopMenuChrome" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="TopMenuChrome" Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Menu.Resources>
            <MenuItem Header="文件" x:Name="FileMenu">
                <MenuItem Header="导入排序或存档…" Click="Import_Click" />
                <MenuItem Header="合集管理…" Click="Collections_Click" />
                <Separator />
                <MenuItem Header="备份当前排序" Click="BackupOrder_Click" IsEnabled="{Binding HasDocument}" />
                <MenuItem Header="恢复排序备份…" Click="RestoreOrder_Click" />
                <MenuItem Header="恢复游戏配置…" Click="RestoreGameConfig_Click" />
                <MenuItem Header="恢复中断写入…" Click="InterruptedFiles_Click" />
                <MenuItem Header="恢复任务…" Click="TaskRecovery_Click" />
                <MenuItem Header="恢复移除的模组…" Click="RemovedMods_Click" />
                <Separator /><MenuItem Header="退出" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="设置" x:Name="SettingsMenu">
                <MenuItem Header="路径" x:Name="PathsMenu">
                    <MenuItem Header="配置路径…" Click="Paths_Click" /><MenuItem Header="从 Steam 识别…" Click="DetectPaths_Click" />
                </MenuItem>
                <MenuItem Header="外观" x:Name="AppearanceMenu">
                    <MenuItem Header="跟随系统" x:Name="SystemThemeItem" IsCheckable="True" Click="SystemTheme_Click" />
                    <MenuItem Header="日间" x:Name="LightThemeItem" IsCheckable="True" Click="LightTheme_Click" />
                    <MenuItem Header="夜间" x:Name="DarkThemeItem" IsCheckable="True" Click="DarkTheme_Click" />
                </MenuItem>
                <MenuItem Header="AI 设置…" Click="AiSettings_Click" />
                <MenuItem Header="AI 用量预估…" Click="AiUsage_Click" />
                <MenuItem Header="导出诊断日志…" Click="ExportDiagnostics_Click" />
                <MenuItem Header="自定义排序规则…" Click="OrderRules_Click" />
                <MenuItem Header="数据库来源…" Click="CommunityDatabase_Click" />
                <MenuItem Header="模组标识">
                    <MenuItem Header="图标" x:Name="BadgeIconsItem" IsCheckable="True" Click="BadgeIcons_Click" />
                    <MenuItem Header="文字" x:Name="BadgeTextItem" IsCheckable="True" Click="BadgeText_Click" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="游戏">
                <MenuItem x:Name="GameStatusItem" Header="游戏未运行" IsEnabled="False" />
                <Separator />
                <MenuItem Header="查看游戏日志…" Click="GameLog_Click" />
                <MenuItem Header="与游戏排序比较…" Click="CompareGameOrder_Click" />
                <MenuItem Header="按规则整理当前排序" Command="{Binding AutoSortCommand}" />
                <MenuItem Header="恢复 AI 调整记录…" Click="RecoverAi_Click" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem x:Name="CheckUpdatesMenu" Header="检查更新" Click="CheckUpdates_Click" />
                <MenuItem Header="关于" Click="About_Click" />
            </MenuItem>
        </Menu>
        <Grid Grid.Row="1" Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="{Binding GameVersionLabel}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="搜索" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,12,0" />
                <TextBox Grid.Column="1" x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <Grid Grid.Row="2" x:Name="ModPanes">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="DetailsColumn" Width="0.95*" MinWidth="180" /><ColumnDefinition Width="12" />
                    <ColumnDefinition x:Name="AvailableColumn" Width="*" MinWidth="320" /><ColumnDefinition Width="12" /><ColumnDefinition x:Name="OrderColumn" Width="1.15*" MinWidth="240" />
                </Grid.ColumnDefinitions>
                <GridSplitter x:Name="DetailsSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" ToolTip="拖动调整模组资料和未启用列表宽度" AutomationProperties.Name="调整模组资料和未启用列表宽度" />
                <GridSplitter x:Name="OrderSplitter" Grid.Column="3" Style="{StaticResource PaneSplitter}" ToolTip="拖动调整未启用和已启用列表宽度" AutomationProperties.Name="调整未启用和已启用列表宽度" />
                <Border x:Name="ModDetails" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="16" TextElement.Foreground="{DynamicResource TextBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="模组资料" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,16" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,8,0">
                                <Image x:Name="ModPreview" Source="{Binding SelectedPreview}" Stretch="Uniform" MaxHeight="200" Margin="0,0,0,14"
                                       Visibility="{Binding HasSelectedPreview, Converter={StaticResource BooleanVisibility}}" />
                                <TextBlock Text="{Binding SelectedName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="ModDescription" Text="{Binding SelectedDescription}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <StackPanel x:Name="ModLocationSection">
                                <TextBlock Text="路径" FontWeight="SemiBold" Margin="0,18,0,4" />
                                <TextBlock TextWrapping="Wrap"><Hyperlink x:Name="ModDirectoryLink" Click="ModDirectory_Click"
                                    Foreground="{DynamicResource LinkBrush}" ToolTip="打开模组文件夹">
                                    <Run Text="{Binding SelectedDirectory, Mode=OneWay}" />
                                </Hyperlink></TextBlock>
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding HasSelectedWorkshopLink, Converter={StaticResource BooleanVisibility}}">
                                    <TextBlock Text="创意工坊" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBlock TextWrapping="Wrap"><Hyperlink NavigateUri="{Binding SelectedWorkshopUri}" RequestNavigate="Workshop_RequestNavigate" Foreground="{DynamicResource LinkBrush}">
                                        <Run Text="{Binding SelectedWorkshopLink, Mode=OneWay}" />
                                    </Hyperlink></TextBlock>
                                </StackPanel>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,14" />
                                <StackPanel x:Name="ModCompatibilitySection">
                                <TextBlock Text="{Binding SelectedPackage}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
                                <TextBlock TextWrapping="Wrap"><Run Text="作者：" /><Run Text="{Binding SelectedAuthor, Mode=OneWay}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run Text="来源：" /><Run Text="{Binding SelectedSource, Mode=OneWay}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasSelectedContent, Converter={StaticResource BooleanVisibility}}"><Run Text="内容：" /><Run Text="{Binding SelectedContent, Mode=OneWay}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run Text="支持版本：" /><Run Text="{Binding SelectedVersions, Mode=OneWay}" /></TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0"><Run Text="前置：" /><Run Text="{Binding SelectedDependencies, Mode=OneWay}" /></TextBlock>
                                <TextBlock Text="{Binding SelectedRules}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding HasSelectedRules, Converter={StaticResource BooleanVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <DockPanel>
                        <WrapPanel x:Name="AvailableHeader" DockPanel.Dock="Top" Margin="2,4,2,12" Orientation="Horizontal">
                            <WrapPanel x:Name="AvailableSortControls" Orientation="Horizontal">
                                <Button x:Name="RowHeightButton" Content="行高" MinWidth="42" Padding="6,6" Margin="0,0,4,4"
                                        Click="RowHeight_Click" ToolTip="调整所有模组列表的行高" AutomationProperties.Name="调整模组行高" />
                                <Popup x:Name="RowHeightPopup" PlacementTarget="{Binding ElementName=RowHeightButton}" Placement="Bottom"
                                       StaysOpen="False" AllowsTransparency="True" Closed="RowHeightPopup_Closed">
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
                                        <StackPanel Width="240">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="模组行高：" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
                                                <TextBox x:Name="RowHeightInput" Width="60" Text="38" MaxLength="3" TextAlignment="Center"
                                                         TextChanged="RowHeightInput_Changed" LostKeyboardFocus="RowHeightInput_LostFocus"
                                                         PreviewKeyDown="RowHeightInput_KeyDown" ToolTip="输入 28–64，回车确认" AutomationProperties.Name="模组行高数值" />
                                            </StackPanel>
                                            <Slider x:Name="RowHeightSlider" Style="{StaticResource ModRowHeightSlider}" Minimum="28" Maximum="64"
                                                    Value="38" ValueChanged="RowHeight_Changed" PreviewMouseLeftButtonDown="RowHeightSlider_MouseDown"
                                                    PreviewKeyDown="RowHeightSlider_KeyDown" Margin="0,8,0,10" AutomationProperties.Name="模组行高" />
                                            <Button Content="恢复默认" Click="RowHeightReset_Click" HorizontalAlignment="Right" Margin="0" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                                <TextBlock x:Name="AvailableTitle" Text="未启用" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,8,0" />
                                <ComboBox x:Name="SourceFilterBox" Width="140" Margin="0,0,10,4" SelectedIndex="0"
                                          SelectionChanged="SourceFilter_Changed" ToolTip="仅筛选未启用列表" AutomationProperties.Name="未启用来源筛选">
                                    <ComboBoxItem Content="全部来源" Tag="All" /><ComboBoxItem Content="仅本地 Mod" Tag="Local" />
                                    <ComboBoxItem Content="仅创意工坊 Mod" Tag="Workshop" />
                                </ComboBox>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock x:Name="AvailableSortLabel" Text="排序顺序" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource MutedBrush}" />
                                <ComboBox x:Name="AvailableSortBox" Width="104" Margin="0,0,6,0" SelectedIndex="0" SelectionChanged="AvailableSort_Changed"
                                          ToolTip="未启用模组排序：名称按字母排列，中文按拼音" AutomationProperties.Name="未启用模组排序方式">
                                    <ComboBoxItem Content="名称" Tag="Name" />
                                    <ComboBoxItem Content="包名" Tag="PackageId" />
                                    <ComboBoxItem Content="作者" Tag="Author" />
                                    <ComboBoxItem Content="近期新增" Tag="RecentlyAdded" />
                                    <ComboBoxItem Content="近期更新" Tag="RecentlyUpdated" />
                                    <ComboBoxItem Content="Mod 格式" Tag="ModFormat" />
                                </ComboBox>
                                <Button x:Name="AvailableSortDirectionButton" Content="{Binding AvailableSortDirectionLabel}" Click="AvailableSortDirection_Click"
                                        MinWidth="44" Padding="6,6" Margin="0" ToolTip="切换未启用列表的正序或降序" AutomationProperties.Name="切换未启用模组排序方向" />
                                </StackPanel>
                            </WrapPanel>
                            <TextBlock x:Name="AvailableCountText" Text="{Binding AvailableCountLabel}" Foreground="{DynamicResource MutedBrush}" Margin="10,6,0,6" VerticalAlignment="Center" />
                        </WrapPanel>
                        <Expander DockPanel.Dock="Bottom" Header="{Binding ScanIssuesLabel}" MaxHeight="140" Margin="0,8,0,0"
                                  Visibility="{Binding HasScanIssues, Converter={StaticResource BooleanVisibility}}">
                            <DataGrid Style="{StaticResource ModGrid}" ItemsSource="{Binding ScanIssues}" RowHeight="NaN">
                                <DataGrid.Columns><DataGridTextColumn Header="读取记录" Binding="{Binding Message}" Width="*" ElementStyle="{StaticResource IssueMessage}" /></DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <DataGrid x:Name="AvailableGrid" Style="{StaticResource ModGrid}" ItemsSource="{Binding VisibleAvailableMods}"
                                  MouseDoubleClick="Available_DoubleClick" ToolTip="Ctrl／Shift 多选；Enter 加入排序，也可拖到右侧；双击加入单项">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="模组" Width="*" CellStyle="{StaticResource MarkedCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                        <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ModBadges}" />
                                        <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ModActivityIcons}" Margin="0,0,3,0" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource ModName}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
                <Border Grid.Column="4" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="8,4,8,12">
                            <TextBlock Text="已启用" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="OrderSourceFilterBox" Width="140" Margin="0,0,10,4" SelectedIndex="0"
                                      SelectionChanged="SourceFilter_Changed" ToolTip="仅筛选已启用列表；位置仍为真实排序位置" AutomationProperties.Name="已启用来源筛选">
                                <ComboBoxItem Content="全部来源" Tag="All" /><ComboBoxItem Content="仅本地 Mod" Tag="Local" />
                                <ComboBoxItem Content="仅创意工坊 Mod" Tag="Workshop" />
                            </ComboBox>
                            <TextBlock Text="{Binding OrderCountLabel}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                        </WrapPanel>
                        <Border x:Name="OrderStatusPanel" Grid.Row="2" Background="{DynamicResource HeaderBrush}" CornerRadius="4" Padding="8" Margin="0,8,0,0"
                                ToolTip="{Binding OrderStatusTooltip}" Visibility="{Binding HasOrderStatus, Converter={StaticResource BooleanVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="WarningsButton" Click="Warnings_Click" Padding="4" Margin="0,0,12,0" ToolTip="查看警告模组和原因">
                                <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource WarningIcon}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding WarningCountLabel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel></Button>
                                <Button x:Name="ErrorsButton" Click="Errors_Click" Padding="4" Margin="0" ToolTip="查看错误模组和原因">
                                <StackPanel Orientation="Horizontal">
                                <ContentControl ContentTemplate="{StaticResource ErrorIcon}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorCountLabel}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel></Button>
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="1">
                            <DataGrid x:Name="OrderGrid" Style="{StaticResource ModGrid}" ItemsSource="{Binding VisibleRows}"
                                      MouseDoubleClick="Order_DoubleClick" ToolTip="Ctrl／Shift 多选；拖动排序；Delete 移出，也可拖到中间；双击移出单项">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="44" CellStyle="{StaticResource ModIconCell}" />
                                    <DataGridTemplateColumn Header="模组" Width="*" CellStyle="{StaticResource MarkedCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <DockPanel LastChildFill="True" VerticalAlignment="Center">
                                            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ModBadges}" />
                                            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ModActivityIcons}" Margin="0,0,3,0" />
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource OrderModName}" />
                                        </DockPanel>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="" Width="34" CellStyle="{StaticResource ModIconCell}"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                        <Border x:Name="DiagnosticHitArea"
                                                ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="60000"
                                                AutomationProperties.Name="{Binding DiagnosticTooltip}">
                                            <Border.ToolTip><ToolTip MaxWidth="440" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><TextBlock Text="{Binding DiagnosticTooltip}" TextWrapping="Wrap" /></ToolTip></Border.ToolTip>
                                            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource IconHitArea}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers>
                                                <DataTrigger Binding="{Binding Severity}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers></Style></Border.Style>
                                            <Grid IsHitTestVisible="False">
                                                <ContentControl ContentTemplate="{StaticResource WarningIcon}" Visibility="{Binding HasWarning, Converter={StaticResource BooleanVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                <ContentControl ContentTemplate="{StaticResource ErrorIcon}" Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="请读取当前排序或导入文件" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style><Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding HasDocument}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style></TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="LastActionText" Text="{Binding LastAction}" Foreground="{DynamicResource TextBrush}"
                               TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastAction}"
                               Visibility="{Binding HasLastAction, Converter={StaticResource BooleanVisibility}}" />
                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}" />
                    <Button x:Name="CancelImportDownloadButton" Content="停止等待下载" Visibility="Collapsed" Click="CancelImportDownload_Click"
                            HorizontalAlignment="Left" Padding="6,2" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="MinWidth" Value="46" /><Setter Property="Padding" Value="8,8" />
                            <Setter Property="Margin" Value="4,0,0,0" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="RefreshButton" Content="{Binding ScanActionLabel}" Click="Scan_Click" />
                    <Button x:Name="UndoButton" Content="撤销" Command="{Binding UndoCommand}" ToolTip="撤销上一步操作（Ctrl+Z）" />
                    <Button x:Name="RedoButton" Content="取消撤销" Command="{Binding RedoCommand}" ToolTip="取消撤销（Ctrl+Y／Ctrl+Shift+Z）" />
                    <Button x:Name="ClearOrderButton" Content="清空" Command="{Binding ClearOrderCommand}" ToolTip="清除当前清单的模组，保留游戏本体和 DLC；可撤销" />
                    <Button Content="上移" Command="{Binding MoveUpCommand}" ToolTip="搜索时暂停调整顺序" />
                    <Button Content="下移" Command="{Binding MoveDownCommand}" ToolTip="搜索时暂停调整顺序" />
                    <Button x:Name="AiSortingButton" Content="自动排序" Click="AiSorting_Click" ToolTip="打开自动排序窗口" />

                    <Button Content="导出排序" Click="Export_Click" IsEnabled="{Binding HasDocument}" />
                    <Button x:Name="SaveOrderButton" Content="保存排序" Click="SaveOrder_Click" IsEnabled="{Binding HasDocument}" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" />
                    <Button x:Name="LaunchGameButton" Content="开始游戏" Click="LaunchGame_Click" ToolTip="{Binding Header, ElementName=GameStatusItem}" />
                </StackPanel>
            </Grid>
        </Border>
        <Canvas x:Name="ModInteractionOverlay" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True" />
        <Border x:Name="UpdateNotice" Grid.RowSpan="3" Panel.ZIndex="100" Visibility="Collapsed"
                Width="370" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,18,0"
                Padding="16" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource AccentBrush}"
                Background="{DynamicResource PanelBrush}">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button x:Name="UpdateDismissButton" DockPanel.Dock="Right" Content="×" Padding="6,0" MinWidth="24" Margin="8,0,0,0"
                            ToolTip="关闭通知" Click="DismissUpdate_Click" />
                    <TextBlock x:Name="UpdateNoticeTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="UpdateNoticeText" Margin="0,10,0,12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UpdateRetryButton" Content="重试" Visibility="Collapsed" Click="CheckUpdates_Click" />
                    <Button x:Name="UpdateInstallButton" Content="更新并重启" Visibility="Collapsed" Click="InstallUpdate_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
