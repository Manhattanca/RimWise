<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\database.snapshot.gz" LogicalName="RimWise.Databases.snapshot.gz" />
    <ProjectReference Include="..\RimWise.Core\RimWise.Core.csproj" />
    <ProjectReference Include="..\RimWise.Formats\RimWise.Formats.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)helper\RimWise.TestHelper.dll" LogicalName="RimWise.TestHelper.dll" />
  </ItemGroup>
  <Target Name="CompileFixedTestHelper" BeforeTargets="PrepareResources">
    <PropertyGroup><HelperOutput>$(BaseIntermediateOutputPath)helper\</HelperOutput><FrameworkRuntime>$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319</FrameworkRuntime></PropertyGroup>
    <MakeDir Directories="$(HelperOutput)" />
    <ItemGroup><HelperReferences Include="$(FrameworkRuntime)\mscorlib.dll;$(FrameworkRuntime)\System.dll;$(FrameworkRuntime)\System.Core.dll;$(FrameworkRuntime)\System.Xml.dll" /></ItemGroup>
    <Csc Sources="..\RimWise.TestHelper\VerseCompileContracts.cs" References="@(HelperReferences)" OutputAssembly="$(HelperOutput)Assembly-CSharp.dll" TargetType="Library" NoStandardLib="true" NoConfig="true" Deterministic="true" UseSharedCompilation="false" />
    <Csc Sources="..\RimWise.TestHelper\ProbeComponent.cs;..\RimWise.TestHelper\NewGameJourney.cs" References="@(HelperReferences);$(HelperOutput)Assembly-CSharp.dll" OutputAssembly="$(HelperOutput)RimWise.TestHelper.dll" TargetType="Library" NoStandardLib="true" NoConfig="true" Deterministic="true" UseSharedCompilation="false" />
  </Target>
</Project>
