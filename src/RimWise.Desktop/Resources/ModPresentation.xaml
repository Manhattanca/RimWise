<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:RimWise.Desktop.Presentation">
    <p:MarkerBackgroundConverter x:Key="MarkerBackground" />
    <Style x:Key="MarkedRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource MarkerBackground}">
            <Binding Path="MarkerColor" /><Binding Path="(ItemsControl.AlternationIndex)" RelativeSource="{RelativeSource Self}" />
            <Binding Path="Background" RelativeSource="{RelativeSource AncestorType=DataGrid}" />
        </MultiBinding></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
        </Style.Triggers>
    </Style>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <Style x:Key="IconHitArea" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="200" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
            <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        </Style>
        <DataTemplate x:Key="ModBadges">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <p:ModThumbnail x:Name="RowThumbnail" Installation="{Binding Installation}"
                                Width="{DynamicResource ModThumbnailSize}" Height="{DynamicResource ModThumbnailSize}" />
                <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.ShowModBadgeIcons, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanVisibility}}">
                    <Border x:Name="SourceIconHitArea" Style="{StaticResource IconHitArea}" Margin="0,0,2,0"
                            ToolTip="{Binding SourceTooltip}" AutomationProperties.Name="{Binding SourceTooltip}">
                    <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                        <Grid Width="20" Height="20">
                            <Ellipse x:Name="WorkshopDisk" Fill="#173952" Visibility="Collapsed" />
                            <Path x:Name="SourceGlyph" Width="20" Height="20" Data="{Binding SourceIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.35"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
                            <Ellipse x:Name="WorkshopHub" Width="4.1" Height="4.1" Margin="11.45,4.15,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     Fill="White" Visibility="Collapsed" />
                        </Grid>
                    </Viewbox>
                    </Border>
                    <Border x:Name="CodeKindHitArea" Style="{StaticResource IconHitArea}" MinWidth="31" Padding="3,0" CornerRadius="3" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                            ToolTip="{Binding CodeKindTooltip}" AutomationProperties.Name="{Binding CodeKindLabel}"
                            Visibility="{Binding HasCodeKindBadge, Converter={StaticResource BooleanVisibility}}">
                        <TextBlock Text="{Binding CodeKindIcon}" IsHitTestVisible="False" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource LinkBrush}" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding DataContext.ShowModBadgeText, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanVisibility}}">
                    <TextBlock Text="{Binding SourceLabel}" Width="58" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding SourceTooltip}" Foreground="{DynamicResource MutedBrush}" />
                    <TextBlock Text="{Binding CodeKindLabel}" Width="57" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding CodeKindTooltip}" Foreground="{DynamicResource LinkBrush}"
                               Visibility="{Binding HasCodeKindBadge, Converter={StaticResource BooleanVisibility}}" />
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWorkshopSource}" Value="True">
                    <Setter TargetName="WorkshopDisk" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SourceGlyph" Property="Stroke" Value="White" />
                    <Setter TargetName="SourceGlyph" Property="StrokeThickness" Value="1.6" />
                    <Setter TargetName="WorkshopHub" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="WarningIcon">
            <Viewbox Width="18" Height="18"><Canvas Width="20" Height="20">
                <Path Data="M 10,1 L 19,18 L 1,18 Z" Fill="{DynamicResource WarningIconBrush}" />
                <Path Data="M 10,6 L 10,11 M 10,13 L 10,15" Stroke="#302609" StrokeThickness="2" />
            </Canvas></Viewbox>
        </DataTemplate>
        <DataTemplate x:Key="ErrorIcon">
            <Grid Width="18" Height="18"><Ellipse Fill="{DynamicResource ErrorIconBrush}" />
                <Path Data="M 9,4 L 9,10 M 9,12 L 9,14" Stroke="White" StrokeThickness="2" />
            </Grid>
        </DataTemplate>
        <Style x:Key="OrderModName" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="ToolTip" Value="{Binding RowTooltip}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasWarning}" Value="True"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModListCell" TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
            <!-- Center content in the selected row height; fixed vertical padding clips 24px badges in compact rows. -->
            <Setter Property="Padding" Value="12,0" />
        </Style>
        <Style x:Key="MarkedCell" TargetType="DataGridCell" BasedOn="{StaticResource ModListCell}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
                <Border Background="{TemplateBinding Background}" BorderThickness="0"
                        Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    <Setter Property="Background" Value="{Binding Background, RelativeSource={RelativeSource AncestorType=DataGridRow}}" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding MarkerColor}" Value="{x:Null}" />
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ModIconCell" TargetType="DataGridCell" BasedOn="{StaticResource MarkedCell}">
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <DataTemplate x:Key="ModActivityIcons">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border x:Name="AddedIconHitArea" Style="{StaticResource IconHitArea}" Margin="2,0" ToolTip="{Binding AddedTooltip}"
                      AutomationProperties.Name="{Binding AddedTooltip}"
                      Visibility="{Binding IsRecentlyAdded, Converter={StaticResource BooleanVisibility}}">
                    <Grid Width="18" Height="18" IsHitTestVisible="False">
                    <Ellipse Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.6" />
                    <Path Data="M 9,4 L 9,14 M 4,9 L 14,9" Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.8" />
                    </Grid>
                </Border>
                <Border x:Name="UpdatedIconHitArea" Style="{StaticResource IconHitArea}" Margin="2,0" ToolTip="{Binding UpdatedTooltip}"
                      AutomationProperties.Name="{Binding UpdatedTooltip}"
                      Visibility="{Binding IsRecentlyUpdated, Converter={StaticResource BooleanVisibility}}">
                    <Grid Width="18" Height="18" IsHitTestVisible="False">
                    <Path Data="M 14,6 A 6,6 0 1 0 15,11 M 14,1 L 14,6 L 9,6" Stroke="{DynamicResource LinkBrush}" StrokeThickness="1.7" />
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
    <DataTemplate x:Key="ModIdentity">
        <DockPanel LastChildFill="True" VerticalAlignment="Center">
            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ModBadges}" />
            <ContentControl DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource ModActivityIcons}" Margin="0,0,3,0" />
            <TextBlock Text="{Binding Name}" Style="{StaticResource OrderModName}" />
        </DockPanel>
    </DataTemplate>
    <DataTemplate x:Key="ModSeverity">
        <Border Style="{StaticResource IconHitArea}" ToolTip="{Binding DiagnosticTooltip}" AutomationProperties.Name="{Binding DiagnosticTooltip}">
            <Grid IsHitTestVisible="False">
                <ContentControl ContentTemplate="{StaticResource WarningIcon}" Visibility="{Binding HasWarning, Converter={StaticResource BooleanVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <ContentControl ContentTemplate="{StaticResource ErrorIcon}" Visibility="{Binding HasError, Converter={StaticResource BooleanVisibility}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
