<Window x:Class="RimWise.Desktop.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="AI 设置" Width="740" Height="740" MinWidth="620" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Border Background="{DynamicResource PageBrush}" Padding="24"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <TextBlock Text="AI 设置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">
                <Button x:Name="PasteConnectionButton" Content="粘贴连接信息并填入" Click="PasteConnection_Click" HorizontalAlignment="Left" Margin="0,0,0,6" />
                <TextBlock Text="可直接粘贴中转站连接信息、JSON 或环境变量。识别后请核对地址；不会自动发送请求。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,16" />
                <CheckBox x:Name="EnabledBox" Content="启用 AI 接入" Margin="0,0,0,16" />
                <TextBlock Text="服务" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                <ComboBox x:Name="ProviderBox" Margin="0,0,0,6" SelectionChanged="Provider_Changed" MaxDropDownHeight="310" />
                <TextBlock x:Name="ServiceNote" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,12" />
                <StackPanel x:Name="EndpointPanel">
                    <TextBlock Text="API 地址" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="EndpointBox" TextChanged="Endpoint_Changed" Margin="0,0,0,16" ToolTip="支持基础地址（如 https://服务地址/v1/）或完整的 /v1/chat/completions 接口地址" />
                </StackPanel>
                <TextBlock Text="API 密钥" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="ReplaceKeyButton" Content="更换密钥" Click="ReplaceKey_Click" DockPanel.Dock="Right" />
                    <TextBlock x:Name="ApiKeyStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <PasswordBox x:Name="ApiKeyBox" PasswordChanged="Key_Changed" Margin="0,0,0,12" />
                <TextBlock Text="模型" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6" />
                <DockPanel Margin="0,0,0,6">
                    <Button x:Name="FetchModelsButton" DockPanel.Dock="Right" Content="获取模型" Click="FetchModels_Click" />
                    <Grid>
                        <ComboBox x:Name="ModelListBox" SelectionChanged="Model_Changed" MaxDropDownHeight="260" ToolTip="选择服务返回的模型；获取列表不会调用模型生成。" />
                        <TextBox x:Name="ModelBox" ToolTip="填写服务商提供的模型名称或推理接入点 ID" />
                    </Grid>
                </DockPanel>
                <CheckBox x:Name="ManualModelBox" Content="手动填写模型" Checked="ManualModel_Changed" Unchecked="ManualModel_Changed" Margin="0,0,0,12" />
                <Button x:Name="TestConnectionButton" Content="测试 AI 连接" Click="Test_Click" HorizontalAlignment="Left" Margin="0,0,0,16" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" />
                <Expander x:Name="AdvancedOptions" Header="高级配置" Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10">
                <CheckBox x:Name="StreamingBox" Content="实时显示 AI 回报" Margin="0,12,0,6"
                          ToolTip="服务需支持流式回复及用量回报；不支持时关闭，收到完整回复后显示。不会自动重试付费请求。" />
                </Expander>
                <TextBlock Text="连接测试只检查接口与密钥，不调用模型生成，也不上传模组清单。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" IsCancel="True" />
            <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" />
        </StackPanel>
    </Grid></Border>
</Window>
