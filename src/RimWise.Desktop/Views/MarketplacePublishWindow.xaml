<Window x:Class="RimWise.Desktop.Views.MarketplacePublishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="发布排序" Width="900" Height="790"
        MinWidth="900" MinHeight="560" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
    </Window.Resources>
    <Border Background="{DynamicResource PageBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="发布排序" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock x:Name="SnapshotSummary" Foreground="{DynamicResource MutedBrush}" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <Button x:Name="AuthorMenuButton" Content="未登录  ▾" Click="AuthorMenu_Click" Padding="12,7" Margin="0,0,8,0"/>
                <Border Background="{DynamicResource HeaderBrush}" CornerRadius="5" Padding="12,7">
                    <TextBlock Text="审核通过后上架" Foreground="{DynamicResource LinkBrush}" FontSize="12"/>
                </Border>
            </StackPanel>
            <Popup x:Name="AuthorPopup" Grid.Column="1" PlacementTarget="{Binding ElementName=AuthorMenuButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                <Border Width="390" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="5" Padding="16">
                    <StackPanel>
                        <TextBlock Text="发布账号" FontWeight="SemiBold"/>
                        <TextBlock x:Name="AuthorStatus" Text="尚未登录" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button x:Name="LoginButton" Content="登录 GitHub" Click="Login_Click" Padding="12,6"/>
                            <Button x:Name="LogoutButton" Content="退出登录" Click="Logout_Click" Padding="12,6"/>
                        </StackPanel>
                        <TextBlock x:Name="LoginStatus" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock Text="登录应用配置随软件提供。登录时将在浏览器打开 GitHub；授权完成后会自动返回 RimWise。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
            <StackPanel>
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                    <StackPanel x:Name="EditorPanel">
                        <TextBlock Text="排序标题" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TitleBox" MaxLength="200" TextChanged="Draft_Changed" AutomationProperties.Name="排序标题"/>
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="PublishedIdPanel" Grid.Column="2" Visibility="Collapsed"><TextBlock Text="排序标识" Style="{StaticResource FieldLabel}"/><TextBlock x:Name="PublishedIdText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,7,0,0"/></StackPanel>
                            <StackPanel><TextBlock Text="排序版本" Style="{StaticResource FieldLabel}"/><TextBox x:Name="VersionBox" MaxLength="64" TextChanged="Draft_Changed" AutomationProperties.Name="排序版本" ToolTip="例如 1.0；更新时自动推进为 1.1、1.2"/></StackPanel>
                        </Grid>
                        <TextBlock Text="游戏版本（可多选）" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <WrapPanel x:Name="GameVersionChoices" Margin="0,0,0,6">
                            <CheckBox Content="1.7（unstable 测试版）" Tag="1.7" Click="GameVersionChoice_Click" Margin="0,0,18,5"/>
                            <CheckBox Content="1.6" Tag="1.6" Click="GameVersionChoice_Click" Margin="0,0,18,5"/>
                            <CheckBox Content="1.5" Tag="1.5" Click="GameVersionChoice_Click" Margin="0,0,18,5"/>
                            <CheckBox Content="1.4" Tag="1.4" Click="GameVersionChoice_Click" Margin="0,0,18,5"/>
                            <CheckBox Content="1.3" Tag="1.3" Click="GameVersionChoice_Click" Margin="0,0,18,5"/>
                            <CheckBox Content="1.2" Tag="1.2" Click="GameVersionChoice_Click" Margin="0,0,18,5"/>
                            <CheckBox Content="1.1" Tag="1.1" Click="GameVersionChoice_Click" Margin="0,0,18,5"/>
                            <CheckBox Content="1.0" Tag="1.0" Click="GameVersionChoice_Click" Margin="0,0,18,5"/>
                        </WrapPanel>
                        <TextBox x:Name="GameVersionBox" MaxLength="512" TextChanged="GameVersion_Changed" AutomationProperties.Name="支持的游戏版本"
                                 ToolTip="可填写多个版本，用逗号分隔；例如 1.7, 1.6.4633。"/>
                        <TextBlock Text="也可以手动填写 Steam 分支对应的精确版本号；当前 1.7 unstable 为测试版。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock Text="Steam 创意工坊合集编号或链接（可选）" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <TextBox x:Name="CollectionBox" MaxLength="500" TextChanged="Collection_Changed" AutomationProperties.Name="Steam 创意工坊合集编号或链接" ToolTip="粘贴合集链接或输入数字编号"/>
                        <TextBlock x:Name="CollectionFetchStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <TextBlock Text="简介" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <TextBox x:Name="DescriptionBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                 MinHeight="94" MaxHeight="180" VerticalScrollBarVisibility="Auto" MaxLength="8000" TextChanged="Draft_Changed" AutomationProperties.Name="排序简介"/>
                        <TextBlock Text="图片（可选，最多三张；首张为封面）" Style="{StaticResource FieldLabel}" Margin="0,15,0,6"/>
                        <WrapPanel x:Name="ImageList"/>
                        <Button Content="添加图片" Click="AddImages_Click" HorizontalAlignment="Left"/>
                        <TextBlock Text="PNG / JPEG，单张上限约 5.24 MB。上传时自动压缩，尽量将总量控制在 7 MB 内；优先无损，必要时高保真压缩，保留分辨率与透明效果。请勿上传个人隐私或违规内容。" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        <StackPanel x:Name="ReleaseNotesPanel" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Text="更新日志（可选）" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="ReleaseNotesBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     MinHeight="70" MaxHeight="140" VerticalScrollBarVisibility="Auto" MaxLength="4000" TextChanged="Draft_Changed" AutomationProperties.Name="更新日志"/>
                        </StackPanel>
                        <TextBlock x:Name="DlcSummary" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        <TextBlock Text="简介和更新日志均可留空。市场仅托管排序文件，不要求核对模组工坊来源。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,10,0,0"/>
                        <TextBlock x:Name="DraftStatus" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border x:Name="SubmissionPanel" Visibility="Collapsed" Background="{DynamicResource HeaderBrush}" CornerRadius="6" Padding="16" Margin="0,14,0,0">
                    <StackPanel><TextBlock Text="已提交，等待审核" FontWeight="SemiBold"/><TextBlock Text="审核通过并上架后，刷新市场即可查看；排序标识届时显示在市场详情和“我的排序与草稿”中。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8"/>
                        <TextBlock TextWrapping="Wrap"><Hyperlink Click="OpenSubmission_Click" Foreground="{DynamicResource LinkBrush}"><Run x:Name="SubmissionLinkText"/></Hyperlink></TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="0,14,0,12">
            <ProgressBar x:Name="BusyProgress" Height="3" Visibility="Collapsed" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HeaderBrush}" Margin="0,0,0,8"/>
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <DockPanel Grid.Row="3">
            <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="关闭" Click="Close_Click"/>
            <Button x:Name="SubmitButton" DockPanel.Dock="Right" Content="提交审核" Click="Submit_Click" Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
            <Button x:Name="SaveDraftButton" DockPanel.Dock="Right" Content="保存草稿" Click="SaveDraft_Click"/>
            <Button x:Name="CancelButton" Content="取消操作" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0" Click="Cancel_Click"/>
        </DockPanel>
    </Grid>
    </Border>
</Window>
