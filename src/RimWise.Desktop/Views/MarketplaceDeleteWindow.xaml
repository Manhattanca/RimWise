<Window x:Class="RimWise.Desktop.Views.MarketplaceDeleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="下架排序" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24">
        <TextBlock Text="选择下架范围" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock x:Name="OrderTitle" TextWrapping="Wrap" Margin="0,12,0,18"/>
        <RadioButton x:Name="SingleVersion" Content="仅下架指定版本" GroupName="Scope" IsChecked="True" Checked="Scope_Changed"/>
        <ComboBox x:Name="VersionPicker" DisplayMemberPath="Version" MaxDropDownHeight="240" Margin="24,10,0,18" AutomationProperties.Name="选择要下架的排序版本"/>
        <RadioButton x:Name="AllVersions" Content="下架此排序的全部版本" GroupName="Scope" Checked="Scope_Changed"/>
        <TextBlock Text="系统核实原发布者后自动处理。仅下架指定版本时，其他版本继续展示；下架最新版后，市场默认使用剩余的最新版本。"
                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,18,0,0" LineHeight="23"/>
        <TextBlock Text="不影响用户已下载的排序或任何模组文件。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="取消" IsCancel="True"/>
            <Button x:Name="ConfirmButton" Content="确认下架" Click="Confirm_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
