<UserControl x:Class="RimWise.Desktop.Views.MarketplacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PageBrush}"
             Focusable="False" IsTabStop="False" FocusVisualStyle="{x:Null}">
    <UserControl.Resources>
        <Style x:Key="MarketPrimaryAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,22,0,8"/>
        </Style>
        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="23"/>
        </Style>
        <Style x:Key="CardItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" CornerRadius="6"
                            BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="PublishFileButton" Content="发布其他排序文件" Click="PublishFile_Click" Style="{StaticResource MarketPrimaryAction}"
                        AutomationProperties.Name="发布其他排序文件" ToolTip="选择其他排序文件用于发布，不会导入、替换或保存当前使用的排序。"/>
                <Button x:Name="PublishButton" Content="发布当前使用排序" Click="Publish_Click" Style="{StaticResource MarketPrimaryAction}"
                        AutomationProperties.Name="发布当前使用排序"/>
                <Button x:Name="MyOrdersButton" Content="我的排序与草稿" Click="MyOrders_Click"/>
                <Button x:Name="AuthorMenuButton" Content="未登录 ▾" Click="AuthorMenu_Click"/>
                <Popup x:Name="AuthorPopup" PlacementTarget="{Binding ElementName=AuthorMenuButton}" Placement="Custom" StaysOpen="False" AllowsTransparency="True">
                    <Border Width="216" Padding="12" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                        <StackPanel>
                            <TextBlock x:Name="AuthorStatus" Text="登录后可提交和更新自己发布的排序。" TextWrapping="Wrap"/>
                            <Button x:Name="LoginButton" Content="登录 / 注册" Click="Login_Click" Margin="0,8,0,0" Padding="10,5"/>
                            <Button x:Name="ManageAccountButton" Content="账号设置" Click="ManageAccount_Click" Margin="0,8,0,0" Padding="10,5" Visibility="Collapsed"/>
                            <Button x:Name="LogoutButton" Content="退出登录" Click="Logout_Click" Margin="0,4,0,0" Padding="10,5" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="排序市场（测试）" FontSize="24" FontWeight="SemiBold"/>
                <Border Background="{DynamicResource HeaderBrush}" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CountText" Text="0 份排序" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                </Border>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Style="{StaticResource SearchInput}" TextChanged="Search_Changed" MaxLength="200" Padding="35,0,12,0"
                         AutomationProperties.Name="搜索排序、作者或游戏版本" ToolTip="在已加载的排序中搜索标题、作者、简介或游戏版本"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
                <TextBlock x:Name="SearchHint" Text="搜索排序、作者或游戏版本" Margin="36,0,12,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False"/>
            </Grid>
            <Button x:Name="RefreshButton" Grid.Column="1" Content="刷新" Click="Refresh_Click" ToolTip="从市场重新读取排序（F5）"/>
        </Grid>
        <Border x:Name="CacheBanner" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource HeaderBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12,9" Margin="0,0,0,12">
            <TextBlock x:Name="CacheText" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"/>
        </Border>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*" MinWidth="260"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.35*" MinWidth="360"/></Grid.ColumnDefinitions>
            <Grid>
                <ListBox x:Name="ResultsList" Style="{StaticResource {x:Type ListBox}}" Background="{DynamicResource PageBrush}" BorderThickness="0" Padding="0,0,4,0"
                         SelectionChanged="Result_Selected" ItemContainerStyle="{StaticResource CardItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="市场排序">
                    <ListBox.ItemTemplate><DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Width="32" Height="36" VerticalAlignment="Top" CornerRadius="5" Background="{DynamicResource HeaderBrush}">
                                <TextBlock Text="{Binding Monogram}" FontWeight="SemiBold" FontSize="17" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Entry.Title}" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Entry.DisplayAuthor}" Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" MaxHeight="42" LineHeight="21" Margin="0,9,0,10" Foreground="{DynamicResource MutedBrush}"/>
                                <TextBlock Text="{Binding VersionLabel}" Foreground="{DynamicResource LinkBrush}" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="320">
                    <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="30" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18"/>
                    <TextBlock x:Name="EmptyTitle" Text="尚未读取市场" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="EmptyDescription" Text="进入市场后读取已发布的排序。" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,0" LineHeight="22"/>
                </StackPanel>
            </Grid>
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <StackPanel x:Name="DetailPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" MaxWidth="340">
                        <TextBlock Text="选择一份排序" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="查看简介、版本说明与所需 DLC。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Grid x:Name="DetailPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,22,22,22">
                            <StackPanel x:Name="DetailContent">
                                <StackPanel x:Name="DetailImages"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DetailTitle" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <StackPanel x:Name="VersionPickerPanel" Grid.Column="1" Width="155" Margin="16,0,0,0" Visibility="Collapsed">
                                        <TextBlock Text="排序版本" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="VersionPicker" DisplayMemberPath="Version" SelectionChanged="Version_Selected" MaxDropDownHeight="260" AutomationProperties.Name="选择排序版本"/>
                                        <TextBlock Text="默认下载最新版" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock x:Name="DetailAuthor" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock x:Name="DetailId" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                <WrapPanel Margin="0,15,0,0">
                                    <Border Background="{DynamicResource HeaderBrush}" CornerRadius="4" Padding="9,4" Margin="0,0,8,4"><TextBlock x:Name="DetailVersion" FontSize="12"/></Border>
                                    <Border Background="{DynamicResource HeaderBrush}" CornerRadius="4" Padding="9,4" Margin="0,0,8,4"><TextBlock x:Name="DetailGameVersion" FontSize="12"/></Border>
                                    <Border Background="{DynamicResource HeaderBrush}" CornerRadius="4" Padding="9,4" Margin="0,0,0,4"><TextBlock x:Name="DetailModCount" FontSize="12" Text="模组数待读取"/></Border>
                                </WrapPanel>
                                <TextBlock Text="简介" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="DetailDescription" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="版本说明" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="DetailReleaseNotes" Style="{StaticResource BodyText}"/>
                                <TextBlock Text="所需 DLC" Style="{StaticResource SectionLabel}"/>
                                <TextBlock x:Name="DetailDlc" Style="{StaticResource BodyText}"/>
                                <StackPanel x:Name="VersionHistoryPanel" Visibility="Collapsed">
                                    <TextBlock Text="其他版本更新日志" Style="{StaticResource SectionLabel}"/>
                                    <ItemsControl x:Name="VersionHistory">
                                        <ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,14">
                                            <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                            <TextBlock Text="{Binding Notes}" Style="{StaticResource BodyText}"/>
                                        </StackPanel></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <StackPanel x:Name="WorkshopPanel" Visibility="Collapsed">
                                    <TextBlock Text="工坊合集" Style="{StaticResource SectionLabel}"/>
                                    <TextBlock TextWrapping="Wrap"><Hyperlink Click="Workshop_Click" Foreground="{DynamicResource LinkBrush}"><Run x:Name="WorkshopText"/></Hyperlink></TextBlock>
                                </StackPanel>
                                <TextBlock x:Name="DetailWarning" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                        <Border Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="DownloadButton" Content="下载排序并另存为" Click="Download_Click" IsEnabled="False" Padding="12,8"/>
                                <Button x:Name="UseButton" Content="下载排序并使用" Click="Use_Click" IsEnabled="False" Padding="12,8"
                                        Style="{StaticResource MarketPrimaryAction}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ProgressBar x:Name="BusyProgress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HeaderBrush}" Margin="0,0,0,8"/>
            <DockPanel Grid.Row="1" MinHeight="32">
                <Button x:Name="CancelButton" Content="取消" DockPanel.Dock="Right" Visibility="Collapsed" Click="Cancel_Click" Padding="12,4" MinWidth="64"/>
                <TextBlock x:Name="StatusText" Text="尚未读取市场" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
