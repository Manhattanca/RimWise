<Window x:Class="RimWise.Desktop.Views.InsertionPickerWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Style="{StaticResource {x:Type Window}}" Title="选择新增 Mod" Width="1100" Height="650" MinWidth="780" MinHeight="460" WindowStartupLocation="CenterOwner">
 <Border Background="{DynamicResource PageBrush}" Padding="24"><Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="将要测试的新增 Mod 放入右侧。未选新增项也可直接整理当前排序并测试。尚未保存的新增项已自动选入；前置自动补齐，原有 Mod 仅按需求调整位置。" TextWrapping="Wrap" Margin="0,0,0,16"/>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid Grid.Column="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock x:Name="AvailableTitle" Text="未启用" FontSize="18" Margin="0,0,0,8"/>
    <TextBox x:Name="SearchBox" Grid.Row="1" TextChanged="Search_Changed" ToolTip="搜索未启用模组" Margin="0,0,0,10"/>
    <DataGrid x:Name="ModsList" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
     CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" Style="{StaticResource ModListGrid}" AlternationCount="2" EnableRowVirtualization="True"
     Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" CellStyle="{StaticResource ModListCell}"
     PreviewKeyDown="List_KeyDown" MouseDoubleClick="List_DoubleClick">
     <DataGrid.ContextMenu><ContextMenu><MenuItem Header="加入测试" Click="Add_Click"/></ContextMenu></DataGrid.ContextMenu>
     <DataGrid.Columns><DataGridTemplateColumn Header="模组" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ContentControl Content="{Binding Row}" ContentTemplate="{StaticResource ModIdentity}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
    </DataGrid>
   </Grid>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock x:Name="SelectedTitle" Text="准备测试" FontSize="18" Margin="0,0,0,8"/>
    <TextBox x:Name="SelectedSearchBox" Grid.Row="1" TextChanged="Search_Changed" ToolTip="搜索准备测试模组" Margin="0,0,0,10"/>
    <DataGrid x:Name="SelectedList" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow"
     CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="None" Style="{StaticResource ModListGrid}" AlternationCount="2" EnableRowVirtualization="True"
     Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" CellStyle="{StaticResource ModListCell}"
     PreviewKeyDown="List_KeyDown" MouseDoubleClick="List_DoubleClick">
     <DataGrid.ContextMenu><ContextMenu><MenuItem Header="移出测试" Click="Remove_Click"/></ContextMenu></DataGrid.ContextMenu>
     <DataGrid.Columns><DataGridTemplateColumn Header="模组" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
      <ContentControl Content="{Binding Row}" ContentTemplate="{StaticResource ModIdentity}"/>
     </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
    </DataGrid>
   </Grid>
   <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
    <Button Content="加入 →" Click="Add_Click" Margin="0,0,0,10"/><Button Content="← 移出" Click="Remove_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="CountText" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="取消" IsCancel="True" Margin="0,0,10,0"/>
    <Button x:Name="ConfirmButton" Content="为右侧 Mod 寻找位置" IsEnabled="False" Click="Confirm_Click"/></StackPanel>
  </Grid>
 </Grid></Border>
</Window>
