<Window x:Class="RimWise.Desktop.Views.MissingModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="下载缺少的模组"
        Width="980" Height="560" MinWidth="760" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Border Padding="22" Background="{DynamicResource PageBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock x:Name="SummaryText" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="是否通过 Steam 订阅并下载？排序已导入，可撤销；暂不下载也会保留缺失项。"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="全部下载会先订阅所有来源已确认的模组，再等待下载。来源缺失或失效时，可搜索 Steam 并选择对应模组，或填写工坊链接／编号。"
                           TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0"/>
            </StackPanel>
            <DataGrid Style="{StaticResource ModListGrid}" RowHeight="NaN" x:Name="MissingGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserSortColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource PanelBrush}"
                      AlternatingRowBackground="{DynamicResource AlternateBrush}">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="选择" Width="48">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEnabled="{Binding CanDownload}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="模组标识" Binding="{Binding Identifier}" IsReadOnly="True" Width="1.1*"/>
                    <DataGridTemplateColumn Header="Steam 工坊链接／编号" Width="1.2*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBox Text="{Binding WorkshopInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding CanEditSource}" MinWidth="70" Margin="3"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="状态" Width="1.7*">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="6" VerticalAlignment="Center"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="操作" Width="160">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <StackPanel>
                                <Button Content="订阅下载" IsEnabled="{Binding CanDownload}" Click="DownloadRow_Click" Padding="9,5" Margin="3"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Content="搜索 Steam" IsEnabled="{Binding CanEditSource}" Click="SearchRow_Click" MinWidth="0" Padding="3,5" Margin="3"/>
                                    <Button Grid.Column="1" Content="工坊页" IsEnabled="{Binding HasSource}" Click="PageRow_Click" MinWidth="0" Padding="3,5" Margin="3"/>
                                </Grid>
                            </StackPanel>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="ProgressText" Grid.Row="2" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="DownloadSelectedButton" Content="下载所选" Click="DownloadSelected_Click"/>
                <Button x:Name="DownloadAllButton" Content="全部下载" Click="DownloadAll_Click"/>
                <Button x:Name="CloseButton" Content="暂不下载" Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
