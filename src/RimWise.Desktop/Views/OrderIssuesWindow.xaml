<Window x:Class="RimWise.Desktop.Views.OrderIssuesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="排序问题" Width="780" Height="460" MinWidth="560" MinHeight="300"
        WindowStartupLocation="CenterOwner">
    <Border Padding="20" Background="{DynamicResource PageBrush}"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DataGrid Style="{StaticResource ModListGrid}" RowHeight="NaN" x:Name="IssuesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow" GridLinesVisibility="None" HeadersVisibility="Column"
                  Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                  RowBackground="{DynamicResource PanelBrush}" AlternatingRowBackground="{DynamicResource AlternateBrush}"
                  BorderBrush="{DynamicResource BorderBrush}" MouseDoubleClick="Issue_DoubleClick" SelectionChanged="Selection_Changed">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="模组" Width="190"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <StackPanel><TextBlock Text="{Binding ModName}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Identifier}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12" /></StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="原因" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="EmptyNotice" Text="没有此类问题" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource MutedBrush}" />
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="LocateButton" Content="定位模组" IsEnabled="False" Click="Locate_Click" />
            <Button Content="关闭" IsCancel="True" Click="Close_Click" />
        </StackPanel>
    </Grid></Border>
</Window>
