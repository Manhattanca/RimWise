<Window x:Class="RimWise.Desktop.Views.AiUsageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="AI 用量预估" Width="580" Height="380" MinWidth="440" MinHeight="320"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource PageBrush}" Padding="24">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="当前排序 · 单次 自动排序" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="EstimateText" TextWrapping="Wrap" Margin="0,16,0,0" />
                    <TextBlock x:Name="BreakdownText" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <TextBlock Text="总用量取决于实际请求次数，重试会增加消耗。预估范围不代表最终账单。"
                               Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
            <Button Grid.Row="1" Content="关闭" IsCancel="True" HorizontalAlignment="Right" Margin="0,16,0,0" />
        </Grid>
    </Border>
</Window>
