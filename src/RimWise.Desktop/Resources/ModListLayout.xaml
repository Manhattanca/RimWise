<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:p="clr-namespace:RimWise.Desktop.Presentation">
    <Style x:Key="ModScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ModScrollBar" TargetType="ScrollBar">
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="20" />
                <Setter Property="MinWidth" Value="20" />
                <Setter Property="p:ModScrollInteraction.Enabled" Value="True" />
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ModScrollPage}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="ScrollThumb" Focusable="False">
                                        <Thumb.Template><ControlTemplate TargetType="Thumb">
                                            <Grid Background="Transparent">
                                                <Border x:Name="Grip" HorizontalAlignment="Center" CornerRadius="3" Background="{DynamicResource MutedBrush}"
                                                        Width="{Binding Path=(p:ModScrollInteraction.GripWidth), RelativeSource={RelativeSource AncestorType=ScrollBar}}"
                                                        Opacity="{Binding Path=(p:ModScrollInteraction.GripOpacity), RelativeSource={RelativeSource AncestorType=ScrollBar}}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate></Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ModScrollPage}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ModRowHeightSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="IsSnapToTickEnabled" Value="False" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="4" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
                <Border Height="4" Margin="10,0" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource BorderBrush}" />
                <Track x:Name="PART_Track" Orientation="Horizontal">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                            <RepeatButton.Template><ControlTemplate TargetType="RepeatButton">
                                <Border Height="4" CornerRadius="2" VerticalAlignment="Center" Background="{DynamicResource AccentBrush}" />
                            </ControlTemplate></RepeatButton.Template>
                        </RepeatButton>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb x:Name="HeightThumb" Width="20" Height="20" Focusable="False" Cursor="Hand">
                            <Thumb.Template><ControlTemplate TargetType="Thumb">
                                <Grid x:Name="ThumbFace" RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform><ScaleTransform /></Grid.RenderTransform>
                                    <Ellipse Fill="{DynamicResource InputBrush}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1" />
                                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.15" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.15" Duration="0:0:0.12" />
                                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbFace" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12" />
                                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate></Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ModScrollPage}" Command="Slider.IncreaseLarge" /></Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ModListGrid" TargetType="DataGrid">
        <Style.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource ModScrollBar}" />
        </Style.Resources>
        <Setter Property="RowBackground" Value="{DynamicResource PanelBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource AlternateBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="RowHeight" Value="{DynamicResource ModRowHeight}" />
        <Setter Property="MinRowHeight" Value="{DynamicResource ModRowHeight}" />
    </Style>
</ResourceDictionary>
