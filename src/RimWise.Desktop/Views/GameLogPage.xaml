<UserControl x:Class="RimWise.Desktop.Views.GameLogPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:motion="clr-namespace:RimWise.Desktop.Services" Foreground="{DynamicResource TextBrush}">
 <UserControl.Resources>
  <Style x:Key="LogHeading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,12,0,8"/></Style>
  <Style x:Key="LogSeverityText" TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding LevelLabel}" Value="警告"><Setter Property="Foreground" Value="{DynamicResource WarningTextBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding LevelLabel}" Value="错误"><Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/></DataTrigger>
    <DataTrigger Binding="{Binding LevelLabel}" Value="异常"><Setter Property="Foreground" Value="{DynamicResource ErrorTextBrush}"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="10,5"/><Setter Property="MinWidth" Value="0"/><Setter Property="Margin" Value="0,0,8,6"/></Style>
 </UserControl.Resources>
 <Grid Margin="0,12,0,0">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <motion:NavigationTabStrip x:Name="SourceTabs" Margin="0,0,0,6" HorizontalAlignment="Left">
  <StackPanel Orientation="Horizontal">
   <RadioButton x:Name="StartupTab" Content="启动日志" IsChecked="True" GroupName="LogSource" Style="{StaticResource NavigationTab}" Checked="Source_Changed"/>
   <RadioButton x:Name="RuntimeTab" Content="游戏中日志" GroupName="LogSource" Style="{StaticResource NavigationTab}" Checked="Source_Changed"/>
  </StackPanel>
  </motion:NavigationTabStrip>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel>
      <TextBlock Text="文件信息" Style="{StaticResource LogHeading}"/>
      <TextBlock TextWrapping="Wrap">
       <Hyperlink x:Name="FileInfoLink" Click="RevealFile_Click" Foreground="{DynamicResource LinkBrush}" ToolTip="打开所在文件夹并选中日志文件"><Run x:Name="FileInfoText"/></Hyperlink>
      </TextBlock>
      <TextBlock x:Name="FileStats" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
      <TextBlock Text="统计信息" Style="{StaticResource LogHeading}"/>
      <TextBlock x:Name="CountsText" TextWrapping="Wrap">
       <Run x:Name="TotalCountText" Text="暂无日志"/><LineBreak/>
       <Run x:Name="InfoCountText" Foreground="{DynamicResource LinkBrush}"/><LineBreak/>
       <Run x:Name="WarningCountText" Foreground="{DynamicResource WarningTextBrush}"/><LineBreak/>
       <Run x:Name="ErrorCountText" Foreground="{DynamicResource ErrorTextBrush}"/><LineBreak/>
       <Run x:Name="ExceptionCountText" Foreground="{DynamicResource ErrorTextBrush}"/>
      </TextBlock>
      <TextBlock Text="控制" Style="{StaticResource LogHeading}"/>
      <WrapPanel><Button Content="读取游戏日志" Click="AutoLoad_Click"/><Button Content="选择文件…" Click="ChooseFile_Click"/><Button Content="刷新" Click="Refresh_Click"/><Button x:Name="PauseButton" Content="暂停读取" Click="Pause_Click"/></WrapPanel>
      <CheckBox x:Name="FollowTail" Content="跟随最新日志" IsChecked="True" Margin="0,4,0,12"/>
      <Button Content="打开日志文件夹" Click="OpenFolder_Click" HorizontalAlignment="Left"/>
      <TextBlock Text="AI 分析" Style="{StaticResource LogHeading}"/>
      <WrapPanel><Button x:Name="AnalyzeButton" Content="AI 判断报错来源" Click="Analyze_Click"/><Button x:Name="CancelAnalysisButton" Content="取消分析" Click="CancelAnalysis_Click" IsEnabled="False"/></WrapPanel>
      <TextBlock Text="仅在点击后发送脱敏证据摘要，使用 AI 设置中的服务；不调整排序。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <Grid Grid.Column="2">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Grid Margin="0,0,8,6">
      <TextBox x:Name="SearchText" ToolTip="搜索文本、模组标识或堆栈；仅过滤当前显示缓存" TextChanged="Filter_Changed" AutomationProperties.Name="搜索日志"/>
      <TextBlock Text="搜索日志" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" IsHitTestVisible="False">
       <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchText}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
      </TextBlock>
     </Grid>
     <ComboBox x:Name="LevelFilter" Grid.Column="1" SelectedIndex="0" SelectionChanged="Filter_Changed" Margin="0,0,8,6">
      <ComboBoxItem Content="全部级别"/><ComboBoxItem Content="错误和异常"/><ComboBoxItem Content="警告"/><ComboBoxItem Content="信息"/>
     </ComboBox>
     <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="上一条" Click="Previous_Click"/><Button Content="下一条" Click="Next_Click"/><Button Content="末尾" Click="End_Click"/></StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" x:Name="ReadStatus" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
    <ListBox x:Name="LinesList" Grid.Row="2" SelectionChanged="Line_Selected" ScrollViewer.HorizontalScrollBarVisibility="Auto"
      ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding Number}" Width="60" Foreground="{DynamicResource MutedBrush}"/>
      <TextBlock Text="{Binding LevelLabel}" Width="48" Style="{StaticResource LogSeverityText}"/>
      <TextBlock Text="{Binding Text}" Style="{StaticResource LogSeverityText}" FontFamily="Consolas, Microsoft YaHei UI" TextTrimming="CharacterEllipsis" MaxWidth="1500"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <GridSplitter Grid.Row="3" Height="7" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows"/>
    <TextBox x:Name="DetailText" Grid.Row="4" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
    <Border Grid.Row="5" x:Name="AnalysisPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8,0,0">
     <StackPanel><TextBlock Text="AI 判断结果" FontWeight="SemiBold"/><TextBox x:Name="AnalysisText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="150" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent"/></StackPanel>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
