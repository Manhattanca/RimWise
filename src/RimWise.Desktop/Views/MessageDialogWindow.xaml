<Window x:Class="RimWise.Desktop.Views.MessageDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}"
        Width="560" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="0" GlassFrameThickness="0"
                            CornerRadius="8" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border x:Name="DialogSurface" Background="{DynamicResource PageBrush}"
            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Margin="24,16,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" />
                <Button x:Name="CloseButton" Grid.Column="1" Width="32" Height="32" MinWidth="32"
                        Padding="8" Margin="0" Background="Transparent" BorderBrush="Transparent"
                        ToolTip="关闭" AutomationProperties.Name="关闭" Click="Close_Click"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5" />
                </Button>
            </Grid>
            <Grid Grid.Row="1" Margin="24,22,24,26">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid x:Name="SeverityIcon" Width="34" Height="34" Margin="0,1,16,0" VerticalAlignment="Top"
                      IsHitTestVisible="False" AutomationProperties.Name="提示">
                    <Ellipse x:Name="CircleIcon" Stroke="{DynamicResource LinkBrush}" StrokeThickness="2" Margin="2" />
                    <Path x:Name="TriangleIcon" Data="M 17,2 L 33,31 L 1,31 Z" Stroke="{DynamicResource WarningIconBrush}"
                          StrokeThickness="2" StrokeLineJoin="Round" Visibility="Collapsed" />
                    <TextBlock x:Name="IconGlyph" Text="?" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource LinkBrush}" />
                </Grid>
                <ScrollViewer x:Name="MessageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" MaxHeight="380" CanContentScroll="False">
                    <TextBlock x:Name="MessageText" TextWrapping="Wrap" LineHeight="24" />
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0" CornerRadius="0,0,8,8" Padding="24,16">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right"
                            KeyboardNavigation.TabNavigation="Cycle" />
            </Border>
        </Grid>
    </Border>
</Window>
