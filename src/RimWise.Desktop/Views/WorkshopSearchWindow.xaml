<Window x:Class="RimWise.Desktop.Views.WorkshopSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="查找 Steam 工坊模组"
        Width="800" Height="540" MinWidth="660" MinHeight="400" WindowStartupLocation="CenterOwner">
    <Border Padding="22" Background="{DynamicResource PageBrush}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Steam 按标题和简介搜索。模组标识可能未被收录，可改用模组名称；选择结果后仍会核对下载文件中的包名。"
                       TextWrapping="Wrap" Margin="0,0,0,12"/>
            <DockPanel Grid.Row="1" Margin="0,0,0,12">
                <Button x:Name="SearchButton" DockPanel.Dock="Right" Content="搜索" Click="Search_Click"/>
                <TextBox x:Name="SearchText" MaxLength="200" KeyDown="SearchText_KeyDown" VerticalContentAlignment="Center"/>
            </DockPanel>
            <DataGrid Style="{StaticResource ModListGrid}" x:Name="ResultsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                      SelectionChanged="SelectionChanged" GridLinesVisibility="None"
                      Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}" RowBackground="{DynamicResource PanelBrush}"
                      AlternatingRowBackground="{DynamicResource AlternateBrush}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="模组名称" Binding="{Binding Title}" Width="*"/>
                    <DataGridTextColumn Header="工坊编号" Binding="{Binding Id}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="StatusText" Grid.Row="3" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="{DynamicResource MutedBrush}"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="PageButton" Content="打开工坊页" IsEnabled="False" Click="Page_Click"/>
                <Button x:Name="ChooseButton" Content="使用此工坊编号" IsEnabled="False" Click="Choose_Click"/>
                <Button Content="取消" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
