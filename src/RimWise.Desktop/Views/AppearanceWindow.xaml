<Window x:Class="RimWise.Desktop.Views.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:RimWise.Desktop.Services"
        xmlns:views="clr-namespace:RimWise.Desktop.Views"
        Style="{StaticResource {x:Type Window}}" Title="外观"
        Width="980" Height="730" MinWidth="820" MinHeight="600" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="Slider" BasedOn="{StaticResource AppearanceSlider}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource SearchInput}">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <!-- Paint the entire client area, including the padding. Transparency belongs
         inside PreviewArea, not in unpainted margins over the owner window. -->
    <Border Background="{DynamicResource PageBrush}" ClipToBounds="True">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="让 RimWise 更像你" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="修改主题颜色或导入背景图片。即时预览，点击保存才会保存设置；取消会还原。" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid x:Name="EditorBody" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="预设主题" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ComboBox x:Name="PresetBox" SelectedIndex="0" SelectionChanged="Changed" Margin="0,0,0,16" AutomationProperties.Name="预设主题">
                        <ComboBoxItem Content="跟随系统"/><ComboBoxItem Content="日间"/><ComboBoxItem Content="黑夜 · 原版青绿"/>
                        <ComboBoxItem Content="深海蓝"/><ComboBoxItem Content="暖琥珀"/><ComboBoxItem Content="紫罗兰"/><ComboBoxItem Content="纯黑"/>
                    </ComboBox>
                    <TextBlock Text="按钮与选中状态颜色（强调色）" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <views:AppearanceColorEditor x:Name="AccentColor" ColorLabel="强调色" ResourceKey="AccentBrush"/>
                    <TextBlock Text="用于主要按钮、当前页签和选中提示。按钮保留所选颜色，页签与文字会自动保持可读性。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,5,0,14" TextWrapping="Wrap"/>
                    <TextBlock Text="自定义背景" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <WrapPanel Margin="-8,0,0,8">
                        <Button Content="导入图片…" Click="Import_Click" Padding="12,6"/>
                        <Button x:Name="RemoveBackgroundButton" Content="移除背景" Click="Remove_Click" Padding="12,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="ImageStatus" Text="尚未导入图片 · PNG / JPG · 不超过 20 MB" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,8"/>
                    <Button x:Name="ImageAccentButton" Content="使用图片推荐色" Click="ImageAccent_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,14" Padding="12,5"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="显示方式" Margin="0,0,0,6"/>
                            <ComboBox x:Name="PlacementBox" SelectedIndex="0" SelectionChanged="Changed" AutomationProperties.Name="背景显示方式"><ComboBoxItem Content="填满"/><ComboBoxItem Content="完整显示"/></ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="明暗遮罩" Margin="0,0,0,6" ToolTip="过亮或过暗的背景将自动增加遮罩，避免文字无法辨认。"/>
                            <Slider x:Name="ShadeSlider" Minimum="0" Maximum="90" Value="40" ValueChanged="Changed" AutomationProperties.Name="明暗遮罩"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="模糊程度" Margin="0,14,0,6"/><Slider x:Name="BlurSlider" Minimum="0" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="Changed" AutomationProperties.Name="背景模糊程度"/>
                    <TextBlock Text="拖动时仅更新右侧预览，松手后同步其他窗口。" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="面板不透明度（含模组列表；0% 完全透明，100% 不透明）" Margin="0,12,0,6" TextWrapping="Wrap"/><Slider x:Name="OpacitySlider" Minimum="0" Maximum="100" Value="94" ValueChanged="Changed" AutomationProperties.Name="面板不透明度"/>
                    <TextBlock Text="其他UI透明度调整（搜索、选择框和内容区；按钮可在高级设置中单独调整）" Margin="0,12,0,6" TextWrapping="Wrap"/>
                    <Slider x:Name="OtherOpacitySlider" Minimum="0" Maximum="100" Value="94" ValueChanged="Changed" AutomationProperties.Name="其他UI透明度调整"/>
                    <TextBlock Text="点击右侧“透明度高级设置”，直接在主界面选取控件。" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <TextBlock Text="图片位置（也可拖动右侧预览）" Margin="0,12,0,4"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="水平" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><Slider x:Name="PositionXSlider" Minimum="0" Maximum="100" Value="50" ValueChanged="Changed" AutomationProperties.Name="背景水平位置"/></StackPanel>
                        <StackPanel Grid.Column="1"><TextBlock Text="垂直" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><Slider x:Name="PositionYSlider" Minimum="0" Maximum="100" Value="50" ValueChanged="Changed" AutomationProperties.Name="背景垂直位置"/></StackPanel>
                    </Grid>
                    <Expander Header="高级配色" Margin="0,18,0,8">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="点击色块直接选色，可恢复默认。文字颜色与透明度由你决定，请自行留意可读性。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10"/>
                            <TextBlock Text="窗口底色"/><views:AppearanceColorEditor x:Name="PageColor" ColorLabel="窗口底色" ResourceKey="PageBrush" Margin="0,4,0,8"/>
                            <TextBlock x:Name="PageColorNotice" Text="窗口底色使用自定义图片" Foreground="{DynamicResource MutedBrush}" FontSize="12" Visibility="Collapsed" Margin="0,0,0,8"/>
                            <TextBlock Text="面板底色"/><views:AppearanceColorEditor x:Name="PanelColor" ColorLabel="面板底色" ResourceKey="PanelBrush" Margin="0,4,0,8"/>
                            <TextBlock Text="文字颜色"/><views:AppearanceColorEditor x:Name="TextColor" ColorLabel="文字颜色" ResourceKey="TextBrush" Margin="0,4,0,8"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Column="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                <Grid x:Name="PreviewArea" PreviewMouseLeftButtonDown="Preview_Down" PreviewMouseMove="Preview_Move" PreviewMouseLeftButtonUp="Preview_Up" Cursor="SizeAll" Background="{DynamicResource PageBrush}" TextElement.Foreground="{DynamicResource TextBrush}">
                    <services:AppearanceBackdrop x:Name="PreviewBackdrop"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="16">
                        <StackPanel>
                            <TextBlock Text="主界面外观预览" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="修改颜色、图片和透明度后在这里预览。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,10,0,16"/>
                            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="模组排序" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <TextBox Text="搜索模组" IsReadOnly="True" Margin="0,0,0,12"/>
                                    <Border Background="{DynamicResource ListSurfaceBrush}" Padding="12" Margin="0,0,0,6"><TextBlock Text="游戏本体"/></Border>
                                    <Border Background="{DynamicResource ListAlternateBrush}" Padding="12"><TextBlock Text="已启用模组"/></Border>
                                </StackPanel>
                            </Border>
                            <Button x:Name="AdvancedOpacityButton" Content="透明度高级设置" Click="AdvancedOpacity_Click" Margin="0,18,0,0" Padding="16,10" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="返回真实主界面，点击想调整的按钮、输入框或区域；选择时不会执行原功能。" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/>
                            <TextBlock Text="请留意模组前置关系" Foreground="{DynamicResource WarningTextBrush}" Margin="0,12,0,4"/>
                            <TextBlock Text="错误文字保留独立颜色" Foreground="{DynamicResource ErrorTextBrush}"/>
                            <TextBlock Text="拖动仅更新此预览，松手后同步其他窗口。空白处可拖动背景。" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <TextBlock x:Name="Feedback" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MinHeight="26" Margin="0,12,0,6"/>
        <DockPanel x:Name="FooterActions" Grid.Row="3">
            <Button x:Name="ResetButton" Content="恢复默认" Click="Reset_Click" DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="0"/>
            <Button x:Name="ExportThemeButton" Content="导出主题" Click="ExportTheme_Click" DockPanel.Dock="Left" AutomationProperties.Name="导出主题" ToolTip="导出当前外观及背景图片为一个主题文件"/>
            <Button x:Name="ImportThemeButton" Content="导入主题" Click="ImportTheme_Click" DockPanel.Dock="Left" AutomationProperties.Name="导入主题" ToolTip="导入主题文件并预览，点击保存后加入预设"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Click="Cancel_Click"/>
                <Button x:Name="SaveButton" Content="保存" Click="Save_Click" IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}"/>
            </StackPanel>
        </DockPanel>
    </Grid>
    </Border>
</Window>
