<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <!-- Only ApprovedDecompilerTools is exposed. Upstream patch-generation and
         arbitrary-path tool implementations are unnecessary for read-only diagnosis. -->
    <Compile Remove="Vendor/Tools/**/*.cs" />
    <Compile Remove="Vendor/**/*.cs" />
    <Compile Include="Vendor/Services/OwnedAssemblyResolver.cs" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="ICSharpCode.Decompiler" Version="10.0.1.8346" />
    <Compile Include="../RimWise.Integration/Safety/ScopedPaths.cs" Link="Safety/ScopedPaths.cs" />
    <Compile Include="../RimWise.Integration/Safety/PinnedDirectory.cs" Link="Safety/PinnedDirectory.cs" />
  </ItemGroup>
</Project>
