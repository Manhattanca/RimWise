<Window x:Class="RimWise.Desktop.Views.CollectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="命名合集" Width="680" Height="520" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource PageBrush}" Padding="22"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,14">
            <TextBlock Text="命名合集" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Right" Text="排序快照" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
        </DockPanel>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" x:Name="SaveButton" Content="保存当前" Click="Save_Click" IsEnabled="{Binding HasCurrentDocument, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBox x:Name="NameBox" ToolTip="输入合集名称" />
            </DockPanel>
            <ListBox x:Name="CollectionList" Grid.Row="1" BorderBrush="{DynamicResource BorderBrush}"
                     Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                     SelectionChanged="Collection_Changed">
                <ListBox.ItemTemplate><DataTemplate>
                    <Grid Margin="8,6">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Row="1" Text="{Binding Details}" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,0" />
                    </Grid>
                </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="DeleteButton" Content="删除" Click="Delete_Click" IsEnabled="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" />
                <Button x:Name="LoadButton" Content="载入" Click="Load_Click" IsEnabled="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=Window}}" IsDefault="True" />
                <Button Content="关闭" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid></Border>
</Window>
