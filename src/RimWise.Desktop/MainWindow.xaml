<Window x:Class="RimWise.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:RimWise.Desktop.Presentation"
        xmlns:motion="clr-namespace:RimWise.Desktop.Services"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Style="{StaticResource {x:Type Window}}"
        Title="RimWise" Width="1360" Height="820" MinWidth="960" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True" PreviewDragOver="Window_FileDragOver" PreviewDrop="Window_FileDrop">
    <Window.Resources>
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="ResizeDirection" Value="Columns" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Cursor" Value="SizeWE" />
            <Setter Property="Background" Value="{x:Null}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GridSplitter">
                <Border x:Name="SplitterHitArea" Background="{x:Null}" CornerRadius="4">
                    <StackPanel Width="18" VerticalAlignment="Center">
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}" Margin="0,0,0,4" IsHitTestVisible="False" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}" Margin="0,0,0,4" IsHitTestVisible="False" />
                        <Border x:Name="DragGrip" Width="6" Height="24" Background="Transparent" CornerRadius="3"
                                Cursor="SizeWE" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <Border x:Name="DragGripFace" Width="3" Height="24" CornerRadius="1.5" Background="{DynamicResource MutedBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        </Border>
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}" Margin="0,4,0,0" IsHitTestVisible="False" />
                        <Ellipse Width="3" Height="3" Fill="{DynamicResource MutedBrush}" Margin="0,4,0,0" IsHitTestVisible="False" />
                    </StackPanel>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger SourceName="DragGrip" Property="IsMouseOver" Value="True">
                        <Setter TargetName="DragGrip" Property="Background" Value="{DynamicResource HeaderBrush}" />
                        <Setter TargetName="DragGripFace" Property="Width" Value="4" />
                        <Setter TargetName="DragGripFace" Property="Background" Value="{DynamicResource TextBrush}" />
                    </Trigger>
                    <Trigger SourceName="DragGrip" Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="DragGrip" Property="Background" Value="{DynamicResource HeaderBrush}" />
                        <Setter TargetName="DragGripFace" Property="Width" Value="4" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
            <EventSetter Event="DragCompleted" Handler="PaneSplitter_DragCompleted" />
            <EventSetter Event="KeyUp" Handler="PaneSplitter_KeyUp" />
        </Style>
        <Style x:Key="ModGrid" TargetType="DataGrid" BasedOn="{StaticResource ModListGrid}">
            <Setter Property="p:ModWheelMotion.Enabled" Value="True" />
            <Setter Property="CellStyle" Value="{StaticResource MarkedCell}" />
            <Setter Property="AutoGenerateColumns" Value="False" /><Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" /><Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="False" /><Setter Property="CanUserReorderColumns" Value="False" />
            <!-- These columns fill their pane; resize panes with the splitters instead of fixing a column wider than its viewport. -->
            <Setter Property="CanUserResizeColumns" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="SelectionMode" Value="Extended" /><Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="AllowDrop" Value="True" />
            <EventSetter Event="SelectionChanged" Handler="ModSelection_Changed" />
            <EventSetter Event="PreviewKeyDown" Handler="ModGrid_KeyDown" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="ModGrid_MouseDown" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="ModGrid_MouseUp" />
            <EventSetter Event="PreviewMouseMove" Handler="ModGrid_MouseMove" />
            <EventSetter Event="DragOver" Handler="ModGrid_DragOver" />
            <EventSetter Event="Drop" Handler="ModGrid_Drop" />
            <EventSetter Event="DragLeave" Handler="ModGrid_DragLeave" />
            <Setter Property="GridLinesVisibility" Value="None" /><Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="RowBackground" Value="{DynamicResource ListSurfaceBrush}" /><Setter Property="AlternatingRowBackground" Value="{DynamicResource ListAlternateBrush}" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="AlternationCount" Value="2" /><Setter Property="RowStyle" Value="{StaticResource MarkedRow}" />
        </Style>
        <Style x:Key="ModName" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Name}" />
        </Style>
        <Style x:Key="IssueMessage" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" /><Setter Property="ToolTip" Value="{Binding Location}" />
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource PageBrush}">
    <Border x:Name="MainClient">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <motion:AppearanceBackdrop x:Name="MainBackdrop" Grid.RowSpan="2"/>
        <Border x:Name="AppCaption" Background="{DynamicResource SurfaceBrush}" Padding="24,0,6,0" motion:AppearancePage.IsTooling="True" AutomationProperties.Name="窗口标题栏">
            <DockPanel>
                <StackPanel x:Name="CaptionButtons" motion:AppearancePage.IsTooling="True" Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="24"/><Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Margin" Value="2,0,0,0"/><Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/><Setter Property="FontSize" Value="10"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="CaptionBtnChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CaptionBtnChrome" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                                                <Setter TargetName="CaptionBtnChrome" Property="BorderBrush" Value="Transparent"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="CaptionMinimize" Content="&#xE921;" ToolTip="最小化" AutomationProperties.Name="最小化"/>
                    <Button x:Name="CaptionMaximize" Content="&#xE922;" ToolTip="最大化" AutomationProperties.Name="最大化或还原"/>
                    <Button x:Name="CaptionClose" Content="&#xE8BB;" ToolTip="关闭" AutomationProperties.Name="关闭窗口">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="CaptionCloseChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="CaptionCloseChrome" Property="Background" Value="#D9383A"/>
                                        <Setter TargetName="CaptionCloseChrome" Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
                <Border DockPanel.Dock="Left" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="24" Padding="0,0,6,0" Margin="0,0,4,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
                <Menu x:Name="MainMenu" DockPanel.Dock="Left" shell:WindowChrome.IsHitTestVisibleInChrome="True" Padding="0,3" Height="30" MinHeight="0" AlternationCount="6" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
                    <Menu.Style>
                        <Style TargetType="Menu">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsVisible, ElementName=SortingTutorialHost}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Menu.Style>
                    <Menu.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" IsItemsHost="True" /></ItemsPanelTemplate></Menu.ItemsPanel>
                    <Menu.Template>
                        <ControlTemplate TargetType="Menu">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ItemsPresenter HorizontalAlignment="Left" />
                            </Border>
                        </ControlTemplate>
                    </Menu.Template>
                    <Menu.Resources>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Style.Triggers>
                                <Trigger Property="Role" Value="TopLevelHeader">
                                    <Setter Property="motion:TopMenuMotion.Enabled" Value="True" />
                                    <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="10,2" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
    <Grid>
        <Border x:Name="TopMenuChrome" Padding="{TemplateBinding Padding}"
                motion:StateBrushMotion.Target="{DynamicResource ButtonSurfaceBrush}"
                motion:StateBrushMotion.Key="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                motion:StateBrushMotion.IsHovered="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}"
                Background="{Binding Path=(motion:StateBrushMotion.Display), RelativeSource={RelativeSource Self}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="2"><Setter Property="CornerRadius" Value="6,0,0,6" /></DataTrigger>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="5"><Setter Property="CornerRadius" Value="0,6,6,0" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentPresenter x:Name="TopMenuContent" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="TopMenuHoverFace" IsHitTestVisible="False" Panel.ZIndex="1"
                BorderBrush="{DynamicResource NavigationAccentBrush}" BorderThickness="1"
                Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="2"><Setter Property="CornerRadius" Value="6,0,0,6" /></DataTrigger>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="5"><Setter Property="CornerRadius" Value="0,6,6,0" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Border.RenderTransform>
            <Grid Margin="-0.5">
                <Border x:Name="TopMenuHoverBack" Background="{DynamicResource SelectionBrush}" Opacity="0.52"
                        CornerRadius="{Binding CornerRadius, ElementName=TopMenuHoverFace}" />
                <Border x:Name="TopMenuHoverFill" Background="{DynamicResource AccentBrush}" Opacity="0.28"
                        CornerRadius="{Binding CornerRadius, ElementName=TopMenuHoverFace}" />
                <Border x:Name="TopMenuAccentBar" Height="2" Margin="5.5,0,5.5,1.5" VerticalAlignment="Bottom"
                        Background="{DynamicResource NavigationAccentBrush}" CornerRadius="1" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="1" /></Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" CornerRadius="4">
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" MaxHeight="600">
                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" Grid.IsSharedSizeScope="True" />
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
    <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="TopMenuChrome" Property="motion:StateBrushMotion.Target" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
        <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="TopMenuChrome" Property="motion:StateBrushMotion.Target" Value="{DynamicResource ButtonSelectionBrush}" /></Trigger>
    </ControlTemplate.Triggers>
</ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="Role" Value="TopLevelItem">
                                    <Setter Property="motion:TopMenuMotion.Enabled" Value="True" />
                                    <Setter Property="Background" Value="{DynamicResource ButtonSurfaceBrush}" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="Padding" Value="10,2" />
                                    <Setter Property="Height" Value="24" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="MenuItem">
    <Grid>
        <Border x:Name="TopMenuChrome" Padding="{TemplateBinding Padding}"
                motion:StateBrushMotion.Target="{DynamicResource ButtonSurfaceBrush}"
                motion:StateBrushMotion.Key="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}"
                motion:StateBrushMotion.IsHovered="{Binding IsHighlighted, RelativeSource={RelativeSource TemplatedParent}}"
                Background="{Binding Path=(motion:StateBrushMotion.Display), RelativeSource={RelativeSource Self}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0"><Setter Property="CornerRadius" Value="6,0,0,6" /></DataTrigger>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="1"><Setter Property="CornerRadius" Value="0,6,6,0" /><Setter Property="Margin" Value="0,0,6,0" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentPresenter x:Name="TopMenuContent" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
        </Border>
        <Border x:Name="TopMenuHoverFace" IsHitTestVisible="False" Panel.ZIndex="1"
                BorderBrush="{DynamicResource NavigationAccentBrush}" BorderThickness="1"
                Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="4" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="0"><Setter Property="CornerRadius" Value="6,0,0,6" /></DataTrigger>
                        <DataTrigger Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource TemplatedParent}}" Value="1"><Setter Property="CornerRadius" Value="0,6,6,0" /><Setter Property="Margin" Value="0,0,6,0" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.RenderTransform><ScaleTransform ScaleX="0.92" ScaleY="0.92" /></Border.RenderTransform>
            <Grid Margin="-0.5">
                <Border x:Name="TopMenuHoverBack" Background="{DynamicResource SelectionBrush}" Opacity="0.52"
                        CornerRadius="{Binding CornerRadius, ElementName=TopMenuHoverFace}" />
                <Border x:Name="TopMenuHoverFill" Background="{DynamicResource AccentBrush}" Opacity="0.28"
                        CornerRadius="{Binding CornerRadius, ElementName=TopMenuHoverFace}" />
                <Border x:Name="TopMenuAccentBar" Height="2" Margin="5.5,0,5.5,1.5" VerticalAlignment="Bottom"
                        Background="{DynamicResource NavigationAccentBrush}" CornerRadius="1" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="0.2" ScaleY="1" /></Border.RenderTransform>
                </Border>
            </Grid>
        </Border>
    </Grid>
    <ControlTemplate.Triggers>
        <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="TopMenuChrome" Property="motion:StateBrushMotion.Target" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
    </ControlTemplate.Triggers>
</ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Menu.Resources>
                    <MenuItem Header="外观" x:Name="AppearanceMenu" Click="Appearance_Click" />
                    <MenuItem Header="检查更新" x:Name="CheckUpdatesMenu" Click="CheckUpdates_Click" />
                    <MenuItem Header="文件" x:Name="FileMenu">
                        <MenuItem Header="导入排序或存档…" Click="Import_Click" />
                        <MenuItem Header="合集管理…" Click="Collections_Click" />
                        <Separator />
                        <MenuItem Header="备份当前排序" Click="BackupOrder_Click" IsEnabled="{Binding HasDocument}" />
                        <MenuItem Header="恢复排序备份…" Click="RestoreOrder_Click" />
                        <MenuItem Header="恢复游戏配置…" Click="RestoreGameConfig_Click" />
                        <MenuItem Header="恢复中断写入…" Click="InterruptedFiles_Click" />
                        <MenuItem Header="恢复任务…" Click="TaskRecovery_Click" />
                        <MenuItem Header="恢复移除的模组…" Click="RemovedMods_Click" />
                        <Separator /><MenuItem Header="退出" Click="Exit_Click" />
                    </MenuItem>
                    <MenuItem Header="设置" x:Name="SettingsMenu">
                        <MenuItem Header="路径" x:Name="PathsMenu">
                            <MenuItem Header="配置路径…" Click="Paths_Click" /><MenuItem Header="从 Steam 识别…" Click="DetectPaths_Click" />
                        </MenuItem>
                        <MenuItem Header="AI 设置…" Click="AiSettings_Click" />
                        <MenuItem Header="AI 用量预估…" Click="AiUsage_Click" />
                        <MenuItem Header="导出完整排障日志…" Click="ExportDiagnostics_Click" />
                        <MenuItem Header="自定义排序规则…" Click="OrderRules_Click" />
                        <MenuItem Header="数据库来源…" Click="CommunityDatabase_Click" />
                        <MenuItem Header="模组标识">
                            <MenuItem Header="图标" x:Name="BadgeIconsItem" IsCheckable="True" Click="BadgeIcons_Click" />
                            <MenuItem Header="文字" x:Name="BadgeTextItem" IsCheckable="True" Click="BadgeText_Click" />
                        </MenuItem>
                    </MenuItem>
                    <MenuItem Header="游戏" x:Name="GameMenu">
                        <MenuItem x:Name="GameStatusItem" Header="游戏未运行" IsEnabled="False" />
                        <Separator />
                        <MenuItem Header="查看游戏日志…" Click="GameLog_Click" />
                        <MenuItem Header="与游戏排序比较…" Click="CompareGameOrder_Click" />
                        <MenuItem Header="按规则整理当前排序" Command="{Binding AutoSortCommand}" />
                        <MenuItem Header="恢复 AI 调整记录…" Click="RecoverAi_Click" />
                    </MenuItem>
                    <MenuItem Header="帮助" x:Name="HelpMenu">
                        <MenuItem x:Name="SortingGuideMenu" Header="自动排序操作教程" Click="SortingGuide_Click" />
                        <MenuItem Header="关于" Click="About_Click" />
                    </MenuItem>
                </Menu>
                <Border Background="Transparent"/>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1">
        <Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers>
            <DataTrigger Binding="{Binding IsVisible, ElementName=SortingTutorialHost}" Value="True"><Setter Property="IsEnabled" Value="False" /></DataTrigger>
        </Style.Triggers></Style></Grid.Style>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Grid.Row="1">
        <Border x:Name="MainNavigationBackground" DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="0,1,0,1" motion:AppearancePage.IsTooling="True" Padding="24,5,24,5">
            <Grid x:Name="MainToolbar" MinHeight="34">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <motion:NavigationTabStrip x:Name="MainPageTabs" motion:AppearancePage.IsTooling="True" Margin="0,0,6,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="ModsPageTab" Content="模组排序" IsChecked="True" GroupName="MainPage" Style="{StaticResource NavigationTab}" Padding="8,5" Margin="0,0,2,0" Checked="MainPage_Changed"/>
                        <RadioButton x:Name="AiSortingPageTab" Content="自动排序" GroupName="MainPage" Style="{StaticResource NavigationTab}" Padding="8,5" Margin="0,0,2,0" Checked="MainPage_Changed" Click="AiSortingTab_Click"/>
                        <RadioButton x:Name="LogsPageTab" Content="游戏日志" GroupName="MainPage" Style="{StaticResource NavigationTab}" Padding="8,5" Margin="0,0,2,0" Checked="MainPage_Changed"/>
                        <RadioButton x:Name="MarketPageTab" Content="排序市场（测试）" GroupName="MainPage" Style="{StaticResource NavigationTab}" Padding="8,5" Margin="0" Checked="MainPage_Changed"/>
                    </StackPanel>
                </motion:NavigationTabStrip>
                <Border x:Name="GameVersionBar" Grid.Column="1" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="30" Padding="4,0,2,0" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="{Binding GameVersionLabel}" AutomationProperties.Name="检测到的游戏版本">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding GameVersionPrefix}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border Width="1" Height="13" Background="{DynamicResource SurfaceBorderBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="GameVersionText" Text="{Binding GameVersionValue}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="110" ToolTip="{Binding GameVersionLabel}" AutomationProperties.Name="检测到的游戏版本" />
                    </StackPanel>
                </Border>
                <Border x:Name="DlcStatusBar" Grid.Column="2" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Height="30" Padding="4,0,2,0" Margin="0,0,6,0"
                        VerticalAlignment="Center" ToolTip="当前 DLC 启用与安装状态（✓ 表示已启用／已安装，× 表示未安装）" AutomationProperties.Name="DLC 状态">
                    <DockPanel LastChildFill="True" VerticalAlignment="Center">
                        <TextBlock DockPanel.Dock="Left" Text="DLC" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border DockPanel.Dock="Left" Width="1" Height="13" Background="{DynamicResource SurfaceBorderBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ItemsControl ItemsSource="{Binding InstalledDlcStatuses}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border Background="Transparent" CornerRadius="4" Padding="5,2" Margin="0,0,2,0" BorderThickness="0" ToolTip="{Binding StatusTooltip}" AutomationProperties.Name="{Binding StatusTooltip}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}"/>
