                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.5" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource ButtonAccentBrush}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value></Setter>
                        </Style>
                        <Style x:Key="FooterSegmentLeft" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Margin" Value="6,0,0,0" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Tag"><Setter.Value><CornerRadius>6,0,0,6</CornerRadius></Setter.Value></Setter>
                        </Style>
                        <Style x:Key="FooterSegmentMiddle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0,1,1,1" />
                            <Setter Property="Tag"><Setter.Value><CornerRadius>0</CornerRadius></Setter.Value></Setter>
                        </Style>
                        <Style x:Key="FooterSegmentRight" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="BorderThickness" Value="0,1,1,1" />
                            <Setter Property="Tag"><Setter.Value><CornerRadius>0,6,6,0</CornerRadius></Setter.Value></Setter>
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="RefreshButton" Content="{Binding ScanActionLabel}" Click="Scan_Click" Margin="0" Padding="11,0" />
                    <Button x:Name="UndoButton" Content="撤销" Command="{Binding UndoCommand}" Style="{StaticResource FooterSegmentLeft}" ToolTip="撤销上一步操作（Ctrl+Z）" />
                    <Button x:Name="RedoButton" Content="取消撤销" Command="{Binding RedoCommand}" Style="{StaticResource FooterSegmentRight}" ToolTip="取消撤销（Ctrl+Y／Ctrl+Shift+Z）" />
                    <Border Width="1" Height="18" Background="{DynamicResource SurfaceBorderBrush}" Margin="8,0,2,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Button x:Name="ExportOrderButton" Content="导出排序" Click="Export_Click" IsEnabled="{Binding HasDocument}" Margin="6,0,0,0" Padding="11,0" />
                    <Button x:Name="ImportOrderButton" Content="导入排序" Click="Import_Click" ToolTip="导入排序文件或从存档提取排序；保留原顺序，不自动调整或测试"
                            Margin="6,0,0,0" Padding="11,0" FontWeight="SemiBold"
                            Background="{DynamicResource ButtonSurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" />
                    <Button x:Name="SaveOrderButton" Content="保存排序" Click="SaveOrder_Click" IsEnabled="{Binding HasDocument}"
                            Margin="6,0,0,0" Padding="13,0" FontWeight="SemiBold"
                            Background="{DynamicResource ButtonAccentBrush}" Foreground="{DynamicResource AccentTextBrush}" BorderBrush="{DynamicResource AccentBrush}" />
                    <Border Width="1" Height="18" Background="{DynamicResource SurfaceBorderBrush}" Margin="8,0,2,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <Button x:Name="LaunchGameButton" Content="开始游戏" Click="LaunchGame_Click" ToolTip="{Binding Header, ElementName=GameStatusItem}"
                            Margin="6,0,0,0" Padding="13,0" FontWeight="SemiBold"
                            Background="{DynamicResource ButtonSelectionBrush}" Foreground="{DynamicResource NavigationAccentBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" />
                </StackPanel>
            </Grid>
        </Border>
        <Canvas x:Name="ModInteractionOverlay" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True" />
        <StackPanel Grid.RowSpan="3" Panel.ZIndex="100" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,18,0">
        <Border x:Name="UpdateNotice" Visibility="Collapsed" Style="{StaticResource NotificationCard}">
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <Button x:Name="UpdateDismissButton" DockPanel.Dock="Right" Content="×" Padding="6,0" MinWidth="24" Margin="8,0,0,0"
                            ToolTip="关闭通知" Click="DismissUpdate_Click" />
                    <TextBlock x:Name="UpdateNoticeTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock x:Name="UpdateNoticeText" Margin="0,10,0,12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="UpdateRetryButton" Content="重试" Visibility="Collapsed" Click="CheckUpdates_Click" />
                    <Button x:Name="UpdateInstallButton" Content="更新并重启" Visibility="Collapsed" Click="InstallUpdate_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
        <Border x:Name="MarketplaceNotice" Visibility="Collapsed" Style="{StaticResource NotificationCard}" Margin="0,10,0,0">
            <StackPanel>
                <DockPanel>
                    <Button x:Name="MarketplaceNoticeDismissButton" DockPanel.Dock="Right" Content="×" Padding="6,0" MinWidth="24" Margin="8,0,0,0"
                            ToolTip="关闭通知" Click="DismissMarketplaceNotice_Click"/>
                    <TextBlock x:Name="MarketplaceNoticeTitle" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
                </DockPanel>
                <ScrollViewer x:Name="MarketplaceNoticeBody" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="MarketplaceNoticeText" Margin="0,10,0,12" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}" AutomationProperties.LiveSetting="Polite"/></ScrollViewer>
                <ProgressBar x:Name="MarketplaceNoticeProgress" Height="5" Minimum="0" Maximum="100" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource HeaderBrush}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MarketplaceSkipWait" Visibility="Collapsed" Content="跳过等待并导入" Margin="0,12,8,0" Click="SkipMarketplaceWait_Click"/>
                    <Button x:Name="MarketplaceNoticeCancelButton" Content="取消" Margin="0,12,0,0" Click="CancelMarketplaceDownload_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
        </StackPanel>
        </Grid>
        <ContentControl x:Name="SortingTutorialHost" Grid.RowSpan="3" Panel.ZIndex="101" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
    </Grid>
    </Border>

    </Grid>
</Window>





